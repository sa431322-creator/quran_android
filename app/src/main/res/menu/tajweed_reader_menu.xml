<?xml version="1.0" encoding="utf-8"?>
<!-- The reader's quran_menu.xml, less what the tajweed pages cannot do (night mode, the
     translation/page switch, which the mode toggle covers). Same ids and icons. -->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
      xmlns:app="http://schemas.android.com/apk/res-auto">
    <item android:id="@+id/favorite_item"
          android:icon="@drawable/ic_not_favorite"
          android:title="@string/menu_bookmarks"
          app:showAsAction="always" />
    <item android:id="@+id/goto_translation"
          android:icon="@drawable/ic_translation"
          android:title="@string/menu_translation"
          app:showAsAction="always" />
    <item android:id="@+id/rotate_screen"
          android:icon="@drawable/ic_rotate_screen"
          android:title="@string/menu_rotate_screen"
          app:showAsAction="always" />
    <item android:id="@+id/jump"
          android:title="@string/menu_jump"
          app:showAsAction="never" />
    <item android:id="@+id/settings"
          android:icon="@drawable/ic_action_settings"
          android:title="@string/menu_settings"
          app:showAsAction="ifRoom" />
    <item android:id="@+id/help"
          android:title="@string/menu_help"
          app:showAsAction="never"/>
</menu>
