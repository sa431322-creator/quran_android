<?xml version="1.0" encoding="utf-8"?>
<!-- Tasnim start screen (Launch artboard): logo, the main sections and the social links. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/launch_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tasnim_launch_background">

  <ImageView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_gravity="top|center_horizontal"
      android:adjustViewBounds="true"
      android:importantForAccessibility="no"
      android:scaleType="fitStart"
      app:srcCompat="@drawable/tasnim_launch_ornament" />

  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:fillViewport="true">

    <LinearLayout
        android:id="@+id/launch_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

      <FrameLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:paddingStart="16dp"
          android:paddingTop="16dp"
          android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/launch_menu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start"
            android:background="@drawable/tasnim_launch_round_button"
            android:contentDescription="@string/tasnim_menu"
            android:scaleType="center"
            app:srcCompat="@drawable/ic_tasnim_menu"
            app:tint="@color/tasnim_gold_light" />

        <ImageButton
            android:id="@+id/launch_night"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:background="@drawable/tasnim_launch_round_button"
            android:contentDescription="@string/tasnim_night_mode"
            android:scaleType="center"
            app:srcCompat="@drawable/ic_tasnim_moon"
            app:tint="@color/tasnim_gold_light" />
      </FrameLayout>

      <ImageView
          android:layout_width="196dp"
          android:layout_height="196dp"
          android:layout_marginTop="6dp"
          android:contentDescription="@string/tasnim_logo_description"
          android:foreground="@drawable/tasnim_logo_ring"
          android:src="@drawable/tasnim_logo" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:text="@string/app_name"
          android:textAppearance="@style/TasnimTitleText"
          android:textColor="@color/tasnim_gold_light"
          android:textSize="44sp" />

      <LinearLayout
          android:layout_width="250dp"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:divider="@drawable/tasnim_gold_rule"
          android:gravity="center_horizontal"
          android:orientation="vertical"
          android:showDividers="beginning|end">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:text="@string/tasnim_riwaya"
            android:textAppearance="@style/TasnimUiText.Medium"
            android:textColor="@color/tasnim_on_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
      </LinearLayout>

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginStart="20dp"
          android:layout_marginTop="22dp"
          android:layout_marginEnd="20dp"
          android:contentDescription="@string/tasnim_sections_description"
          android:orientation="horizontal">

        <TextView
            android:id="@+id/launch_live"
            style="@style/TasnimLaunchTile"
            android:text="@string/tasnim_section_live"
            app:drawableTopCompat="@drawable/ic_tasnim_live" />

        <Space
            android:layout_width="12dp"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/launch_mushaf"
            style="@style/TasnimLaunchTile"
            android:text="@string/tasnim_section_mushaf"
            app:drawableTopCompat="@drawable/ic_tasnim_mushaf" />

        <Space
            android:layout_width="12dp"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/launch_radio"
            style="@style/TasnimLaunchTile"
            android:text="@string/tasnim_section_radio"
            app:drawableTopCompat="@drawable/ic_tasnim_radio" />
      </LinearLayout>

      <LinearLayout
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="22dp"
          android:orientation="horizontal">

        <ImageButton
            android:id="@+id/launch_website"
            style="@style/TasnimLaunchSocial"
            android:contentDescription="@string/tasnim_social_website"
            app:srcCompat="@drawable/ic_tasnim_web" />

        <ImageButton
            android:id="@+id/launch_email"
            style="@style/TasnimLaunchSocial"
            android:contentDescription="@string/tasnim_social_email"
            app:srcCompat="@drawable/ic_tasnim_mail" />

        <ImageButton
            android:id="@+id/launch_video"
            style="@style/TasnimLaunchSocial"
            android:contentDescription="@string/tasnim_social_video"
            app:srcCompat="@drawable/ic_tasnim_video_channel" />

        <ImageButton
            android:id="@+id/launch_messenger"
            style="@style/TasnimLaunchSocial"
            android:contentDescription="@string/tasnim_social_messenger"
            app:srcCompat="@drawable/ic_tasnim_messenger" />
      </LinearLayout>

      <Space
          android:layout_width="match_parent"
          android:layout_height="0dp"
          android:layout_weight="1"
          android:minHeight="24dp" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:paddingBottom="24dp"
          android:text="@string/tasnim_footer"
          android:textAppearance="@style/TasnimUiText"
          android:textColor="@color/tasnim_on_continue_muted"
          android:textSize="14sp" />
    </LinearLayout>
  </ScrollView>
</FrameLayout>
