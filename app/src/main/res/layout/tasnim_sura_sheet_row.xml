<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    >

  <TextView
      android:id="@+id/sura_row_number"
      style="@style/TasnimUiText.Medium"
      android:layout_width="34dp"
      android:layout_height="34dp"
      android:background="@drawable/tasnim_sura_star"
      android:gravity="center"
      android:textColor="@color/tasnim_gold_text"
      android:textSize="12sp"
      />

  <TextView
      android:id="@+id/sura_row_name"
      style="@style/TasnimUiText.Medium"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:layout_weight="1"
      android:maxLines="1"
      android:textColor="@color/title_color"
      android:textSize="15sp"
      />

  <TextView
      android:id="@+id/sura_row_meta"
      style="@style/TasnimUiText"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:gravity="end"
      android:textColor="@color/tasnim_muted"
      android:textSize="12sp"
      />
</LinearLayout>
