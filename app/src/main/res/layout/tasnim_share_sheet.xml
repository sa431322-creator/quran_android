<?xml version="1.0" encoding="utf-8"?>
<!-- Tasnim: ayah share sheet opened from the ayah toolbar's share button -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/tasnim_sheet_background"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="20dp"
    >

  <View
      android:layout_width="36dp"
      android:layout_height="4dp"
      android:layout_gravity="center_horizontal"
      android:layout_marginBottom="12dp"
      android:background="@drawable/tasnim_sheet_handle"
      />

  <TextView
      android:id="@+id/share_sheet_title"
      style="@style/TasnimUiText.Medium"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="20dp"
      android:layout_marginEnd="20dp"
      android:layout_marginBottom="12dp"
      android:gravity="start"
      android:textColor="@color/title_color"
      android:textSize="16sp"
      />

  <!-- main option: the ayah text with its sura, ayah and page -->
  <LinearLayout
      android:id="@+id/share_sheet_text"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="16dp"
      android:layout_marginEnd="16dp"
      android:background="@drawable/tasnim_segment_track"
      android:foreground="?attr/selectableItemBackground"
      android:gravity="center_vertical"
      android:minHeight="64dp"
      android:orientation="horizontal"
      android:paddingStart="16dp"
      android:paddingTop="10dp"
      android:paddingEnd="16dp"
      android:paddingBottom="10dp"
      >
    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_share"
        app:tint="@color/tasnim_gold"
        />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical"
        >
      <TextView
          style="@style/TasnimUiText.Medium"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="start"
          android:text="@string/tasnim_share_text"
          android:textColor="@color/title_color"
          android:textSize="15sp"
          />
      <TextView
          style="@style/TasnimUiText"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:gravity="start"
          android:text="@string/tasnim_share_text_hint"
          android:textColor="@color/tasnim_muted"
          android:textSize="12sp"
          />
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
      android:id="@+id/share_sheet_image"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="16dp"
      android:layout_marginTop="10dp"
      android:layout_marginEnd="16dp"
      android:background="@drawable/tasnim_segment_track"
      android:foreground="?attr/selectableItemBackground"
      android:gravity="center_vertical"
      android:minHeight="64dp"
      android:orientation="horizontal"
      android:paddingStart="16dp"
      android:paddingTop="10dp"
      android:paddingEnd="16dp"
      android:paddingBottom="10dp"
      >
    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_tasnim_share_image"
        app:tint="@color/tasnim_gold"
        />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical"
        >
      <TextView
          style="@style/TasnimUiText.Medium"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="start"
          android:text="@string/tasnim_share_as_image"
          android:textColor="@color/title_color"
          android:textSize="15sp"
          />
      <TextView
          style="@style/TasnimUiText"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:gravity="start"
          android:text="@string/tasnim_share_as_image_hint"
          android:textColor="@color/tasnim_muted"
          android:textSize="12sp"
          />
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
      android:id="@+id/share_sheet_audio"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="16dp"
      android:layout_marginTop="10dp"
      android:layout_marginEnd="16dp"
      android:background="@drawable/tasnim_segment_track"
      android:foreground="?attr/selectableItemBackground"
      android:gravity="center_vertical"
      android:minHeight="64dp"
      android:orientation="horizontal"
      android:paddingStart="16dp"
      android:paddingTop="10dp"
      android:paddingEnd="16dp"
      android:paddingBottom="10dp"
      >
    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_play"
        app:tint="@color/tasnim_gold"
        />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical"
        >
      <TextView
          style="@style/TasnimUiText.Medium"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="start"
          android:text="@string/tasnim_share_with_audio"
          android:textColor="@color/title_color"
          android:textSize="15sp"
          />
      <TextView
          style="@style/TasnimUiText"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:gravity="start"
          android:text="@string/tasnim_share_with_audio_hint"
          android:textColor="@color/tasnim_muted"
          android:textSize="12sp"
          />
    </LinearLayout>
  </LinearLayout>

  <!-- secondary options -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="16dp"
      android:layout_marginTop="10dp"
      android:layout_marginEnd="16dp"
      android:orientation="horizontal"
      >
    <TextView
        android:id="@+id/share_sheet_copy"
        style="@style/TasnimUiText"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginEnd="5dp"
        android:layout_weight="1"
        android:background="@drawable/tasnim_segment_track"
        android:drawableStart="@drawable/ic_copy"
        android:drawablePadding="8dp"
        android:drawableTint="@color/tasnim_gold"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="@string/tasnim_share_copy"
        android:textColor="@color/title_color"
        android:textSize="14sp"
        />
    <TextView
        android:id="@+id/share_sheet_link"
        style="@style/TasnimUiText"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="5dp"
        android:layout_weight="1"
        android:background="@drawable/tasnim_segment_track"
        android:drawableStart="@drawable/ic_link"
        android:drawablePadding="8dp"
        android:drawableTint="@color/tasnim_gold"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="@string/tasnim_share_link"
        android:textColor="@color/title_color"
        android:textSize="14sp"
        />
  </LinearLayout>
</LinearLayout>
