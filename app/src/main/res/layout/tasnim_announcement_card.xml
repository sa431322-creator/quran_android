<?xml version="1.0" encoding="utf-8"?>
<!-- A server announcement on the launch screen (tasneem-backend ADR 0005); filled in code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/launch_announcement"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginTop="16dp"
    android:layout_marginEnd="20dp"
    android:background="@drawable/tasnim_announcement_bg"
    android:orientation="vertical"
    android:padding="14dp"
    android:visibility="gone">

  <ImageView
      android:id="@+id/announcement_image"
      android:layout_width="match_parent"
      android:layout_height="120dp"
      android:layout_marginBottom="10dp"
      android:contentDescription="@null"
      android:scaleType="centerCrop"
      android:visibility="gone" />

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        app:srcCompat="@drawable/ic_tasnim_info"
        app:tint="@color/tasnim_card_teal" />

    <TextView
        android:id="@+id/announcement_title"
        style="@style/TasnimUiText.Medium"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:textColor="@color/tasnim_card_teal"
        android:textSize="15sp" />

    <ImageButton
        android:id="@+id/announcement_close"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/tasnim_announcement_close"
        app:srcCompat="@drawable/ic_tasnim_close"
        app:tint="@color/tasnim_card_muted" />
  </LinearLayout>

  <TextView
      android:id="@+id/announcement_body"
      style="@style/TasnimUiText"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:lineSpacingExtra="4dp"
      android:textColor="@color/tasnim_card_muted"
      android:textSize="13sp" />

  <LinearLayout
      android:id="@+id/announcement_items"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical" />

  <TextView
      android:id="@+id/announcement_action"
      style="@style/TasnimUiText.Medium"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:background="@drawable/tasnim_announcement_button_bg"
      android:minHeight="40dp"
      android:paddingStart="14dp"
      android:paddingTop="8dp"
      android:paddingEnd="14dp"
      android:paddingBottom="8dp"
      android:textColor="@color/tasnim_cream"
      android:textSize="13sp"
      android:visibility="gone" />
</LinearLayout>
