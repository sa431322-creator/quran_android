<?xml version="1.0" encoding="utf-8"?>
<!-- TV version of the start-screen round button: a gold ring on the button the remote is on -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_focused="true">
    <shape android:shape="oval">
      <solid android:color="#CC1F4E56" />
      <stroke android:width="3dp" android:color="@color/tasnim_gold_light" />
    </shape>
  </item>
  <item>
    <shape android:shape="oval">
      <solid android:color="#99143A40" />
      <stroke android:width="1dp" android:color="#73C8A45E" />
    </shape>
  </item>
</selector>
