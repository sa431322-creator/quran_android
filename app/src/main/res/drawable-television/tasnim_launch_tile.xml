<?xml version="1.0" encoding="utf-8"?>
<!-- TV version of the start-screen tile: a gold frame on the tile the remote is on -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_focused="true">
    <shape android:shape="rectangle">
      <corners android:radius="20dp" />
      <solid android:color="#33E3C58A" />
      <stroke android:width="3dp" android:color="@color/tasnim_gold_light" />
    </shape>
  </item>
  <item>
    <shape android:shape="rectangle">
      <corners android:radius="20dp" />
      <solid android:color="#0FF7F0E1" />
      <stroke android:width="1dp" android:color="#66C8A45E" />
    </shape>
  </item>
</selector>
