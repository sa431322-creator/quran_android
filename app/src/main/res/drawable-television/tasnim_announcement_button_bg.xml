<?xml version="1.0" encoding="utf-8"?>
<!-- TV version of the announcement's action button: a gold ring when the remote is on it -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_focused="true">
    <shape android:shape="rectangle">
      <solid android:color="@color/tasnim_card_teal" />
      <stroke android:width="3dp" android:color="@color/tasnim_gold" />
      <corners android:radius="10dp" />
    </shape>
  </item>
  <item>
    <shape android:shape="rectangle">
      <solid android:color="@color/tasnim_card_teal" />
      <corners android:radius="10dp" />
    </shape>
  </item>
</selector>
