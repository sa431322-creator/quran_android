<?xml version="1.0" encoding="utf-8"?>
<!-- TV version of the continue-reading card: a gold ring when the remote is on it -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_focused="true">
    <shape android:shape="rectangle">
      <corners android:radius="20dp" />
      <solid android:color="@color/tasnim_continue_card" />
      <stroke android:width="3dp" android:color="@color/tasnim_gold_light" />
    </shape>
  </item>
  <item>
    <shape android:shape="rectangle">
      <corners android:radius="20dp" />
      <solid android:color="@color/tasnim_continue_card" />
    </shape>
  </item>
</selector>
