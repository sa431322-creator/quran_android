<?xml version="1.0" encoding="utf-8"?>
<!-- TV: the current sura's row, with a gold ring when the remote is on it -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_focused="true">
    <shape android:shape="rectangle">
      <corners android:radius="14dp" />
      <solid android:color="@color/tasnim_nav_indicator" />
      <stroke android:width="3dp" android:color="@color/tasnim_gold_light" />
    </shape>
  </item>
  <item>
    <shape android:shape="rectangle">
      <solid android:color="@color/tasnim_nav_indicator" />
    </shape>
  </item>
</selector>
