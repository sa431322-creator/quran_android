<?xml version="1.0" encoding="utf-8"?>
<!--
  Tasnim start screen on TV (docs/tv/PLAN.md, phase 1): landscape, the logo on one side and the
  four sections as big remote-friendly tiles on the other. Live video has the first focus.
  Same view ids as layout/tasnim_launch.xml, which TasnimLaunchActivity binds.
  The paddings keep everything inside the TV's safe area (overscan).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/launch_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tasnim_launch_background">

  <ImageView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_gravity="top|center_horizontal"
      android:adjustViewBounds="true"
      android:importantForAccessibility="no"
      android:scaleType="fitStart"
      app:srcCompat="@drawable/tasnim_launch_ornament" />

  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:clipChildren="false"
      android:clipToPadding="false"
      android:fillViewport="true"
      android:paddingStart="48dp"
      android:paddingTop="27dp"
      android:paddingEnd="48dp"
      android:paddingBottom="27dp">

    <LinearLayout
        android:id="@+id/launch_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical">

      <FrameLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:clipChildren="false">

        <ImageButton
            android:id="@+id/launch_menu"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="start"
            android:background="@drawable/tasnim_launch_round_button"
            android:contentDescription="@string/tasnim_menu"
            android:scaleType="center"
            android:stateListAnimator="@animator/tasnim_tv_focus_scale"
            app:srcCompat="@drawable/ic_tasnim_menu"
            app:tint="@color/tasnim_gold_light" />

        <ImageButton
            android:id="@+id/launch_night"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="end"
            android:background="@drawable/tasnim_launch_round_button"
            android:contentDescription="@string/tasnim_night_mode"
            android:scaleType="center"
            android:stateListAnimator="@animator/tasnim_tv_focus_scale"
            app:srcCompat="@drawable/ic_tasnim_moon"
            app:tint="@color/tasnim_gold_light" />
      </FrameLayout>

      <!-- takes the height left under the top buttons, so the content sits in the middle -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="0dp"
          android:layout_weight="1"
          android:clipChildren="false"
          android:gravity="center_vertical"
          android:orientation="horizontal">

        <!-- logo and name -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

          <ImageView
              android:layout_width="200dp"
              android:layout_height="200dp"
              android:contentDescription="@string/tasnim_logo_description"
              android:foreground="@drawable/tasnim_logo_ring"
              android:src="@drawable/tasnim_logo" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="10dp"
              android:text="@string/app_name"
              android:textAppearance="@style/TasnimTitleText"
              android:textColor="@color/tasnim_gold_light"
              android:textSize="48sp" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:text="@string/tasnim_footer"
              android:textAppearance="@style/TasnimUiText"
              android:textColor="@color/tasnim_on_continue_muted"
              android:textSize="16sp" />
        </LinearLayout>

        <!-- server notes and the four sections -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_weight="1.4"
            android:clipChildren="false"
            android:contentDescription="@string/tasnim_sections_description"
            android:orientation="vertical">

          <TextView
              android:id="@+id/launch_maintenance"
              style="@style/TasnimUiText"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginBottom="12dp"
              android:background="@drawable/tasnim_announcement_bg"
              android:backgroundTint="@color/tasnim_gold_light"
              android:gravity="center"
              android:padding="12dp"
              android:textColor="@color/tasnim_card_ink"
              android:textSize="16sp"
              android:visibility="gone" />

          <include layout="@layout/tasnim_announcement_card" />

          <!-- the broadcasts first on TV: they are what a TV is mostly used for -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="16dp"
              android:clipChildren="false"
              android:orientation="horizontal">

            <TextView
                android:id="@+id/launch_live"
                style="@style/TasnimLaunchTile"
                android:paddingTop="28dp"
                android:paddingBottom="28dp"
                android:stateListAnimator="@animator/tasnim_tv_focus_scale"
                android:text="@string/tasnim_section_live"
                android:textSize="20sp"
                app:drawableTopCompat="@drawable/ic_tasnim_live">

              <requestFocus />
            </TextView>

            <Space
                android:layout_width="20dp"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/launch_radio"
                style="@style/TasnimLaunchTile"
                android:paddingTop="28dp"
                android:paddingBottom="28dp"
                android:stateListAnimator="@animator/tasnim_tv_focus_scale"
                android:text="@string/tasnim_section_radio"
                android:textSize="20sp"
                app:drawableTopCompat="@drawable/ic_tasnim_radio" />
          </LinearLayout>

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="20dp"
              android:clipChildren="false"
              android:orientation="horizontal">

            <TextView
                android:id="@+id/launch_mushaf"
                style="@style/TasnimLaunchTile"
                android:paddingTop="28dp"
                android:paddingBottom="28dp"
                android:stateListAnimator="@animator/tasnim_tv_focus_scale"
                android:text="@string/tasnim_section_mushaf"
                android:textSize="20sp"
                app:drawableTopCompat="@drawable/ic_tasnim_mushaf" />

            <Space
                android:layout_width="20dp"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/launch_library"
                style="@style/TasnimLaunchTile"
                android:paddingTop="28dp"
                android:paddingBottom="28dp"
                android:stateListAnimator="@animator/tasnim_tv_focus_scale"
                android:text="@string/tasnim_section_library"
                android:textSize="20sp"
                app:drawableTopCompat="@drawable/ic_tasnim_library" />
          </LinearLayout>
        </LinearLayout>
      </LinearLayout>

      <!-- social links open a browser or mail app, which TVs rarely have: kept hidden on TV -->
      <LinearLayout
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:visibility="gone">

        <ImageButton
            android:id="@+id/launch_website"
            style="@style/TasnimLaunchSocial"
            android:contentDescription="@string/tasnim_social_website"
            app:srcCompat="@drawable/ic_tasnim_web" />

        <ImageButton
            android:id="@+id/launch_email"
            style="@style/TasnimLaunchSocial"
            android:contentDescription="@string/tasnim_social_email"
            app:srcCompat="@drawable/ic_tasnim_mail" />

        <ImageButton
            android:id="@+id/launch_video"
            style="@style/TasnimLaunchSocial"
            android:contentDescription="@string/tasnim_social_video"
            app:srcCompat="@drawable/ic_tasnim_video_channel" />

        <ImageButton
            android:id="@+id/launch_messenger"
            style="@style/TasnimLaunchSocial"
            android:contentDescription="@string/tasnim_social_messenger"
            app:srcCompat="@drawable/ic_tasnim_messenger" />
      </LinearLayout>
    </LinearLayout>
  </ScrollView>
</FrameLayout>
