<?xml version="1.0" encoding="utf-8"?>
<resources>

  <style name="TitleText">
    <item name="android:textSize">16sp</item>
    <item name="android:textColor">@color/title_color</item>
    <item name="android:lines">1</item>
    <item name="android:maxLines">1</item>
  </style>

  <style name="ToolBarArea">
    <item name="android:elevation">4dp</item>
  </style>

  <style name="ToolbarStyle" parent="ThemeOverlay.AppCompat.DayNight.ActionBar">
    <item name="iconTint">@color/toolbar_icon_tint</item>
    <item name="android:textColorPrimary">@color/toolbar_text</item>
    <item name="android:textColorSecondary">@color/toolbar_secondary_text</item>
  </style>

  <style name="ToolbarTitleText" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
    <item name="fontFamily">@font/tasnim_ui_medium</item>
    <item name="android:fontFamily">@font/tasnim_ui_medium</item>
  </style>

  <style name="ToolbarSubtitleText" parent="TextAppearance.Widget.AppCompat.Toolbar.Subtitle">
    <item name="fontFamily">@font/tasnim_ui</item>
    <item name="android:fontFamily">@font/tasnim_ui</item>
  </style>

  <!-- Tasnim UI text. Only for chrome, never for Quran text or ayah snippets. -->
  <style name="TasnimUiText">
    <item name="fontFamily">@font/tasnim_ui</item>
    <item name="android:fontFamily">@font/tasnim_ui</item>
  </style>

  <style name="TasnimUiText.Medium">
    <item name="fontFamily">@font/tasnim_ui_medium</item>
    <item name="android:fontFamily">@font/tasnim_ui_medium</item>
  </style>

  <style name="TasnimTitleText">
    <item name="fontFamily">@font/tasnim_title</item>
    <item name="android:fontFamily">@font/tasnim_title</item>
    <item name="android:textColor">@color/tasnim_primary</item>
    <item name="android:includeFontPadding">false</item>
  </style>

  <style name="NotificationText" parent="android:TextAppearance.StatusBar.EventContent" />

  <style name="NotificationTitle" parent="android:TextAppearance.StatusBar.EventContent.Title" />

  <style name="QuranDialogTheme" parent="Theme.AppCompat.DayNight.Dialog.Alert">
    <item name="android:backgroundDimAmount">0.3</item>
  </style>

  <style name="TranslationText">
    <item name="android:textColor">@android:color/black</item>
    <item name="android:textSize">14sp</item>
  </style>

  <style name="TranslationText.Highlighted">
    <item name="android:textColor">@color/translation_highlight</item>
  </style>

  <style name="TranslationText.NightMode">
    <item name="android:background">@android:color/black</item>
    <item name="android:textColor">@android:color/white</item>
  </style>

  <style name="TranslationText.NightMode.Highlighted">
    <item name="android:textColor">@color/translation_highlight</item>
  </style>

  <style name="PageTypeTitle">
    <item name="android:textColor">@android:color/white</item>
    <item name="android:textSize">18sp</item>
    <item name="android:textStyle">bold</item>
  </style>

  <style name="PageTypeDescription">
    <item name="android:textColor">#aaaaaa</item>
    <item name="android:textSize">16sp</item>
  </style>

  <style name="SearchResult">
    <item name="android:textColor">@color/text_primary</item>
    <item name="android:textSize">16sp</item>
  </style>

  <style name="SearchResult.Location">
    <item name="fontFamily">@font/tasnim_ui</item>
    <item name="android:fontFamily">@font/tasnim_ui</item>
    <item name="android:textColor">@color/text_hint_color</item>
    <item name="android:textSize">14sp</item>
  </style>

  <style name="PanelLabel">
    <item name="fontFamily">@font/tasnim_ui_medium</item>
    <item name="android:fontFamily">@font/tasnim_ui_medium</item>
    <item name="android:textColor">@color/panel_label</item>
    <item name="android:textSize">16sp</item>
  </style>

  <style name="SherlockDropDownItem">
    <item name="android:textAppearance">@style/SherlockDropDownItemText</item>
    <item name="android:paddingLeft">8dp</item>
    <item name="android:paddingRight">8dp</item>
    <item name="android:gravity">center_vertical</item>
  </style>

  <style name="SherlockDropDownItemText">
    <item name="android:textColor">@color/sherlock_primary_text_disable</item>
    <item name="android:textSize">16sp</item>
    <item name="android:textStyle">normal</item>
  </style>

  <style name="SherlockSpinnerItem">
    <item name="android:textAppearance">@style/SherlockSpinnerItemText</item>
    <item name="android:paddingLeft">8dp</item>
    <item name="android:paddingRight">8dp</item>
  </style>

  <style name="SherlockSpinnerItemText">
    <item name="android:textColor">@color/sherlock_primary_text</item>
    <item name="android:textSize">16sp</item>
    <item name="android:textStyle">normal</item>
  </style>

  <style name="ToastText">
    <item name="android:textSize">14sp</item>
    <item name="android:textStyle">normal</item>
    <item name="fontFamily">@font/tasnim_ui</item>
    <item name="android:fontFamily">@font/tasnim_ui</item>
  </style>

  <style name="TasnimLaunchTile" parent="TasnimUiText.Medium">
    <item name="android:layout_width">0dp</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_weight">1</item>
    <item name="android:paddingTop">16dp</item>
    <item name="android:paddingBottom">16dp</item>
    <item name="android:background">@drawable/tasnim_launch_tile</item>
    <item name="android:gravity">center</item>
    <item name="android:drawablePadding">8dp</item>
    <item name="drawableTint">@color/tasnim_gold_light</item>
    <item name="android:textColor">@color/tasnim_on_primary</item>
    <item name="android:textSize">14sp</item>
    <item name="android:clickable">true</item>
    <item name="android:focusable">true</item>
  </style>

  <style name="TasnimLaunchSocial">
    <item name="android:layout_width">52dp</item>
    <item name="android:layout_height">52dp</item>
    <item name="android:layout_marginStart">8dp</item>
    <item name="android:layout_marginEnd">8dp</item>
    <item name="android:background">@drawable/tasnim_launch_social</item>
    <item name="android:scaleType">center</item>
    <item name="tint">@color/tasnim_gold_light</item>
  </style>

  <style name="TasnimNavItem" parent="TasnimUiText.Medium">
    <item name="android:layout_width">0dp</item>
    <item name="android:layout_height">match_parent</item>
    <item name="android:layout_weight">1</item>
    <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    <item name="android:gravity">center</item>
    <item name="android:paddingTop">10dp</item>
    <item name="android:paddingBottom">10dp</item>
    <item name="android:drawablePadding">4dp</item>
    <item name="drawableTint">@color/tasnim_muted</item>
    <item name="android:textColor">@color/tasnim_muted</item>
    <item name="android:textSize">12sp</item>
    <item name="android:clickable">true</item>
    <item name="android:focusable">true</item>
  </style>
</resources>
